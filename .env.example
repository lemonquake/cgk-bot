# Discord Bot Configuration Template
# Created by Aljay Leodones for CGK Linens

# Your Discord Bot Token from the Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Optional: Specific Discord Server (Guild) ID for instant slash command registration during development
GUILD_ID=

# Channel where formal member engagement reports are published
REPORT_CHANNEL_ID=1541562452993511584

# Timezone used to interpret custom report dates and footer timestamps (IANA name)
REPORT_TIMEZONE=Asia/Manila

# Optional path for the local activity database
ACTIVITY_DATABASE_PATH=data/engagement.sqlite3

# Optional path for the onboarding / growth database
COMMUNITY_DATABASE_PATH=data/community.sqlite3

# ── Onboarding channels (optional) ─────────────────────────────────────────
# These are only starting values. Moderators can set them in Discord with
# Mod Panel -> Onboarding -> Channel setup, and those choices always win.
WELCOME_CHANNEL_ID=
ONBOARDING_CHANNEL_ID=
INTRODUCTIONS_CHANNEL_ID=

# How far back the onboarding scanner looks for members never welcomed (days)
ONBOARDING_LOOKBACK_DAYS=30

# ── Community reports ──────────────────────────────────────────────────────
# How often deployed live reports refresh themselves (hours)
REPORT_REFRESH_HOURS=3

# Set to false if the Presence Intent is switched off in the Developer Portal.
# The bot also detects this automatically and starts without it.
ENABLE_PRESENCE_INTENT=true
